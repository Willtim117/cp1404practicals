BoxLayout:
    orientation: 'vertical'
    BoxLayout
        orientation: "horizontal"
        TextInput:
            id: input_number
            text: '37'
            font_size: 80
            size_hint_x: 0.7
            halign: 'center'
            multiline: False
            padding: [10, (self.height - self.line_height)/2]
            on_text: app.handle_calculate(self.text)
        BoxLayout
            orientation: "vertical"
            size_hint_x: 0.3
            Button:
                text: 'UP'
                on_press: app.handle_increment(input_number.text, 1)
            Button:
                text: 'DOWN'
                on_press: app.handle_increment(input_number.text, -1)
#    Button:
#        text: 'Convert miles to km'
#        font_size: 50
#        on_press: app.handle_calculate(input_number.text)
    Label:
        id: output_label
        text: "Will Test"
        font_size: 100
        color: (231, 37, 137, 0.8)
