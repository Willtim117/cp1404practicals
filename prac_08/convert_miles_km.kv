BoxLayout:
    orientation: 'vertical'
    BoxLayout
        orientation: "horizontal"
        TextInput:
            id: input_number
            text: '37'
            font_size: 48
            size_hint_x: 0.7
        BoxLayout
            orientation: "vertical"
            size_hint_x: 0.3
            Button:
                text: 'UP'
                # the following line specifies the function in the app class to call when the button is pressed
                on_press: app.handle_increment(input_number.text, 1)
            Button:
                text: 'DOWN'
                # the following line specifies the function in the app class to call when the button is pressed
                on_press: app.handle_increment(input_number.text, -1)
    Button:
        text: 'Convert miles to km'
        # the following line specifies the function in the app class to call when the button is pressed
        on_press: app.handle_calculate(input_number.text)
    Label:
        id: output_label
        text: "Will Test"
        font_size: 48
        color: (231, 37, 137, 0.8)

